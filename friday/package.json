{
  "name": "friday",
  "productName": "FRIDAY",
  "version": "1.0.0",
  "description": "FRIDAY — a local, sci-fi voice assistant for macOS in the spirit of Iron Man's F.R.I.D.A.Y. Talks, thinks (local Qwen3 brain), acts on your Mac, and tracks directives. Global hotkey HUD, contextual spoken replies, colour-coded tasks.",
  "main": "main.js",
  "author": "David",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder --mac",
    "pack": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.david.friday",
    "productName": "FRIDAY",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "build/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] }
      ],
      "hardenedRuntime": false,
      "darkModeSupport": true
    }
  }
}
