// Application-level settings for the Runner target.
//
// Overrides the values generated by `flutter create` so the macOS app ships as
// "Prism" with a stable bundle identifier (notifications + sync depend on it).

PRODUCT_NAME = Prism

PRODUCT_BUNDLE_IDENTIFIER = com.prismreminders.prism

PRODUCT_COPYRIGHT = Copyright © 2026 Prism. All rights reserved.
